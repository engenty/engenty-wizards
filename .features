# Feature switches of this checkout or install (packages/shared/src/features.ts).
# A line with the name turns a switch on, `name=off` turns it off, `#` keeps the default.
# An account's or a team's switches from the Manage-App lie under this file; this file wins.
# A running runtime reads it at once. `wizards features` lists what counts.

# account            the account in a local install: linking, Settings → Account, the sign-in offer (on by default)
# unsetConnectors    built-in connectors without an OAuth client, shown anyway
# site               the link to the product's own site from the setup
# teamPlans          the Team plan: the team page in the cloud studio, the plan on the account pages
# ownKeys            own API keys in the cloud studio (a plan's switch; on alone)

# A plugin's switches carry its id (declared in its manifest under `features`); `wizards features`
# lists the ones installed here:
# contacts.leadScoring
