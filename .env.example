# --- Required ---------------------------------------------------------------
# The public origin people open (auth callbacks and share links use it).
APP_URL=https://wizards.example.com
# 32+ random bytes: openssl rand -hex 32
BETTER_AUTH_SECRET=
# One key serves text, image, video and web search (Vercel AI Gateway).
AI_GATEWAY_API_KEY=

# --- Sign-in (enable any; each shows up when its keys are set) ---------------
# Callback URLs: <APP_URL>/api/auth/callback/google | github | microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Models (AI SDK ids; prefix openai: / anthropic: to bypass the gateway) ----
MODEL_ARCHITECT=anthropic/claude-sonnet-5.5
MODEL_SMART=anthropic/claude-sonnet-5.5
MODEL_FAST=anthropic/claude-haiku-4.5
MODEL_IMAGE=google/gemini-3.1-flash-image
MODEL_VIDEO=google/veo-3.1-fast-generate-001
# Direct vendor keys (used when no gateway key, or with an explicit prefix)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Billing (Stripe) --------------------------------------------------------
# Webhook endpoint: <APP_URL>/api/billing/webhook
#   events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price for Pro, one-time price for a credit pack
STRIPE_PRICE_PRO=
STRIPE_PRICE_TOPUP=
CREDITS_FREE_MONTHLY=500
CREDITS_PRO_MONTHLY=3000
CREDITS_TOPUP=2000
# Provider cost × markup = credits (1 credit = 1 cent)
CREDITS_MARKUP=2

# --- Abuse limits for shared links --------------------------------------------
LIMIT_VISITOR_RUNS_PER_HOUR=6
LIMIT_DEFAULT_DAILY_RUNS=50
# Cloudflare Turnstile (optional; shown before a public run starts)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Runtime -----------------------------------------------------------------
DATA_DIR=./data
# libSQL/Turso instead of the local file: libsql://… plus token
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Chromium for PDF/PNG and the browser tool: a CDP endpoint, or a local binary
BROWSER_CDP_URL=
CHROME_PATH=
# Agent sandbox (shell/code) via Docker
SANDBOX_ENABLED=1
SANDBOX_IMAGE=engenty-sandbox:latest

# --- Local development only ----------------------------------------------------
# One-click sign-in without OAuth. Ignored when NODE_ENV=production.
DEV_LOGIN=1
