# engenty wizards runs in one of two ways:
#   alone     — one person, one tenant, on this machine (desktop app, `pnpm dev`, own server).
#               Models come from own keys, a local model, or a linked account's credits.
#   managed   — MANAGE_URL is set: people sign in at the Manage-App, every tenant has its own
#               database, and model calls go through the Manage-App's model-gateway.

# --- Always -------------------------------------------------------------------
# The origin people open (links and callbacks use it). Empty: http://localhost:5181 from source
# (`pnpm dev`, the Vite dev server), http://localhost:<API_PORT> once built (`pnpm start`).
APP_URL=
API_PORT=8891
# Listen address. Default: 127.0.0.1 alone, 0.0.0.0 managed.
API_HOST=
DATA_DIR=./data
# Signs cookies and links and derives the store's encryption key: openssl rand -hex 32.
# Alone, the runtime makes one itself and keeps it in DATA_DIR/secret. Required when managed.
APP_SECRET=

# --- Alone: models ---------------------------------------------------------------
# Keys can also be entered in the settings; the desktop app keeps them in the Keychain.
# One key serves text, image, video and web search (Vercel AI Gateway).
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434/v1
# What each model class runs on: [provider:]vendor/model, e.g. anthropic/claude-haiku-4.5,
# openai:gpt-5.4-mini, ollama:qwen3. Steps name the class, never the model.
MODEL_CLASSIFIER=anthropic/claude-haiku-4.5
MODEL_STANDARD=anthropic/claude-haiku-4.5
MODEL_HIGH=anthropic/claude-sonnet-5.5
MODEL_HIGHEST=anthropic/claude-sonnet-5.5
MODEL_IMAGE=google/gemini-3.1-flash-image
MODEL_VIDEO=google/veo-3.1-fast-generate-001
# Audio transcribes voice notes; it must take audio files.
MODEL_AUDIO=google/gemini-3.5-flash-lite
# Speech reads a text aloud (voice-over of a film).
MODEL_SPEECH=google/gemini-3.8-flash-tts
# Names the place of a location field (street, town). Unset: coordinates only, and no
# position leaves this server. e.g. https://nominatim.openstreetmap.org/reverse
GEOCODER_URL=

# --- Alone: entering the studio and the optional account ---------------------------
# The studio answers only with a cookie set by a one-time link printed at start
# (the desktop app passes its own key here). Local development: a "Dev-Login" button instead.
LOCAL_ACCESS_KEY=
DEV_LOGIN=1
# More host names this server answers under, besides APP_URL's and the loopback names.
ALLOWED_HOSTS=
# Where keys entered in the settings are kept: "keychain" (macOS) or empty = an encrypted file.
SECRETS=
# The account service a local runtime can be linked to, its gateway, and the cloud it publishes to.
ACCOUNT_URL=https://account.engenty.ai
ACCOUNT_GATEWAY_URL=https://gateway.engenty.ai
CLOUD_URL=https://engenty.ai

# --- Managed: the Manage-App this runtime belongs to (docs/manage-contract.md) --------
MANAGE_URL=
GATEWAY_URL=
# This runtime's OAuth client at the Manage-App; redirect: <APP_URL>/api/auth/callback
MANAGE_CLIENT_ID=
MANAGE_CLIENT_SECRET=
# Authenticates this runtime at the Manage-App and its gateway, and the Manage-App here.
MANAGE_SERVICE_KEY=

# --- Databases (libSQL) --------------------------------------------------------------
# The control database (links, run index, sessions). Empty = DATA_DIR/control.db.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# One database per tenant. Empty = files in DATA_DIR/tenants. On Turso the Manage-App hands
# out each tenant's URL; a template works without it: libsql://wz-{tenant}-yourorg.turso.io
TENANT_DB_URL_TEMPLATE=
TENANT_DB_AUTH_TOKEN=

# --- Files: assets and workspaces -------------------------------------------------------
# An S3-compatible bucket (Cloudflare R2). Empty = DATA_DIR/objects.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Limits for shared links -----------------------------------------------------------
LIMIT_VISITOR_RUNS_PER_HOUR=6
LIMIT_DEFAULT_DAILY_RUNS=50
# Runs of one tenant that work at the same time; more wait in line.
LIMIT_CONCURRENT_RUNS=4
# End-user results (no account) and their shared links are deleted after this many days.
RESULT_TTL_DAYS=7
# Cloudflare Turnstile (optional; shown before a public run starts)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- What wizards keep for a person (lists, files, connected accounts) --------------------
# Encrypts connected accounts and kept sign-ins: openssl rand -hex 32. Default: derived from APP_SECRET.
STORE_ENC_KEY=
# A person's store is deleted when nobody used it for this many days.
STORE_TTL_DAYS=400

# --- Connectors people sign in to (OAuth) ---------------------------------------------------
# Every client needs the redirect URI <APP_URL>/api/connect/callback (override: CONNECT_REDIRECT_URL).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
CONNECT_REDIRECT_URL=

# --- Browser, video, sandbox ------------------------------------------------------------------
# Chromium for PDF/PNG and the browser tool: a CDP endpoint, or a local binary
BROWSER_CDP_URL=
CHROME_PATH=
# Encodes widget animations to MP4 (frames rendered in Chromium). Without it widgets offer no video.
FFMPEG_PATH=ffmpeg
# Agent sandbox (shell/code): docker | agentos | off
#   docker   one container per run from SANDBOX_IMAGE; needs the host's Docker
#   agentos  one in-process VM per run, no Docker: sh + coreutils, node and npm; Python only
#            through its own tool, with numpy and pure-Python packages; network limited to the
#            npm and PyPI registries. The packages are devDependencies — move them to
#            dependencies to ship them in the image (about 2 GB)
#   off      no shell/code tool (SANDBOX_ENABLED=0 does the same)
# Empty: docker when SANDBOX_IMAGE is on this machine, else agentos when its packages are
# installed (a checkout has them), else off.
SANDBOX=
SANDBOX_IMAGE=engenty-sandbox:latest
