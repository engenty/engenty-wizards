{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "includes": [
      "apps/runtime/src/**",
      "apps/runtime/*.ts",
      "apps/web/src/**",
      "apps/web/*.ts",
      "packages/shared/src/**",
      "packages/plugin-sdk/src/**",
      "modules/**",
      "examples/plugins/**",
      "!apps/runtime/src/db/migrations",
      "!apps/runtime/src/engenty",
      "apps/runtime/src/engenty/shims/**",
      "!apps/web/src/engenty",
      "!packages/shared/src/engenty",
      "!!**/.claude",
      "!!**/dist"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "off", "noArrayIndexKey": "off" },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "noSvgWithoutTitle": "off",
        "noLabelWithoutControl": "off",
        "noAutofocus": "off"
      },
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noExcessiveCognitiveComplexity": "off" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } }
}
