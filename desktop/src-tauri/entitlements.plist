<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundled Node (V8) compiles JavaScript to machine code at runtime. Tauri signs the
       app's own binary and the Node sidecar with this one file. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Node loads native addons (libSQL, canvas) with dlopen. They are signed with the same
       identity (scripts/desktop-bundle.mjs); this covers addons unpacked or built later. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The runner's photo fields, voice notes and location fields (getUserMedia, geolocation). -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>
</dict>
</plist>
