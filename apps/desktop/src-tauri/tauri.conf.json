{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "engenty wizards",
  "mainBinaryName": "engenty-wizards",
  "identifier": "com.engenty.wizards",
  "version": "../../../package.json",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*",
      "capabilities": ["shell"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/server/": "server/",
      "sidecar/watchdog.mjs": "watchdog.mjs"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "macos/de.lproj/InfoPlist.strings"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["engenty-wizards"]
      }
    }
  }
}
