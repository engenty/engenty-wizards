{
  "name": "engenty-wizards",
  "version": "0.1.0",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "dev:portless": "portless wizards pnpm dev",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "db:generate": "drizzle-kit generate && DB_SCHEMA=control drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.54",
    "@ai-sdk/gateway": "^4.0.82",
    "@ai-sdk/openai": "^4.0.67",
    "@dagrejs/dagre": "^3.1.1",
    "@executor-js/plugin-openapi": "1.6.8",
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "1.67.0",
    "@mastra/docker": "0.8.0",
    "@mastra/mcp": "^2.1.2",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@tanstack/react-query": "^5.104.0",
    "@turbodocx/html-to-docx": "^1.23.1",
    "@xyflow/react": "^12.12.0",
    "ai": "7.0.102",
    "aws4fetch": "^1.0.20",
    "docx": "^9.8.1",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.3",
    "effect": "4.0.0-beta.59",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "0.8.3",
    "hono": "^4.13.12",
    "imapflow": "^2.2.1",
    "jose": "6.2.12",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "pdf-parse": "^2.4.5",
    "playwright-core": "1.63.0",
    "postal-mime": "^4.0.2",
    "qr-scanner": "1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^7.18.4",
    "rfc6902": "^5.3.0",
    "turndown": "^7.2.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@rivet-dev/agentos-core": "0.2.22",
    "@rivet-dev/agentos-runtime-core": "0.2.22",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
